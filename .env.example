NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/alpinefilm.sqlite
VIDEO_DIR=./data/videos
POSTER_DIR=./data/posters
SUBTITLE_DIR=./data/subtitles
UPLOAD_DIR=./data/uploads
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_PLAYBACK_SECRET=replace-with-another-32-character-secret
REGISTRATION_INVITE_CODE=replace-with-a-private-code-for-friends
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PLAYBACK_TOKEN_TTL=2h
UPLOAD_CHUNK_BYTES=8388608
MAX_POSTER_BYTES=5242880
MAX_SUBTITLE_BYTES=2097152
CORS_ORIGINS=*
